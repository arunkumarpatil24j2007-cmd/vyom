# Primary AI Model Provider: Google Gemini 3 Flash (Free-Tier Standard)
PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Google Sheets Error & Issue Reporting Webhook
GOOGLE_SHEET_WEBHOOK_URL=your_google_sheet_webhook_url_here

# Secondary Fallback Provider (Optional)
QWEN_API_KEY=your_openrouter_api_key_here
QWEN_MODEL=qwen/qwen3.8-27b
QWEN_BASE_URL=https://openrouter.ai/api/v1
